<?xml version="1.0"?>
<!--
  All ClickHouse system log tables disabled.

  Why: with application writes gated on real changes, system logs were the
  only thing still touching this disk. query_log was the last one left and
  was still taking ~800 rows / 10 min — not from real work, but from the
  translator and notifier polling their job queues every 5 s. Each flush
  writes a fresh part that then has to be merged and dropped, so a table of
  pure polling noise kept the disk busy around the clock.

  That churn is billed: Azure meters managed-disk operations at the block
  layer, and gonkavote was drawing ~11.8 ops/s (≈21M ops/month) around the
  clock while proxy and epoch — same image, same mount options, no
  ClickHouse — sit at 0.4-1.25 ops/s. The gap is what these tables cost.

  Earlier rounds disabled the high-volume ones (text_log, trace_log,
  metric_log, asynchronous_metric_log, processors_profile_log,
  query_metric_log) and dropped their accumulated data; metric_log in
  particular has 1136 columns and its merges failed continuously with
  MEMORY_LIMIT_EXCEEDED, spraying stack traces into the server log at
  ~2 GiB/day. This file now covers every remaining one.

  Trade-off: no query_log means no post-hoc "what wrote to this table and
  when" — the exact tool used to find all of the above. Re-enable it (drop
  its remove="1" and restart) whenever that question comes up again; it is
  cheap to turn back on for a diagnostic window.

  Server-level logging verbosity is separate — see logger.xml.
-->
<clickhouse>
    <query_log remove="1"/>

    <trace_log remove="1"/>

    <text_log remove="1"/>

    <metric_log remove="1"/>

    <part_log remove="1"/>

    <processors_profile_log remove="1"/>

    <asynchronous_metric_log remove="1"/>

    <error_log remove="1"/>

    <query_metric_log remove="1"/>
    <query_thread_log remove="1"/>
    <query_views_log remove="1"/>
    <asynchronous_insert_log remove="1"/>
    <backup_log remove="1"/>
    <blob_storage_log remove="1"/>
    <s3queue_log remove="1"/>
    <opentelemetry_span_log remove="1"/>
    <crash_log remove="1"/>
</clickhouse>
